+/// Amanu: applies one `path=value` entry to an AEC3 configuration. Returns
+/// `false` if the path is unknown or the value does not parse. `output=linear`
+/// sets `filter.export_linear_aec_output` and `*output_linear`.
+fn apply_aec3_entry(
+    cfg: &mut sonora::config::EchoCanceller3Config,
+    output_linear: &mut bool,
+    key: &str,
+    value: &str,
+) -> bool {
+    macro_rules! knobs {
+        ($($t:ty : $($f:ident).+ ;)*) => {
+            $(
+                if key == stringify!($($f).+).replace(' ', "") {
+                    return match value.parse::<$t>() {
+                        Ok(v) => { cfg$(.$f)+ = v; true }
+                        Err(_) => false,
+                    };
+                }
+            )*
+        };
+    }
+    if key == "output" {
+        return match value {
+            "linear" => {
+                cfg.filter.export_linear_aec_output = true;
+                *output_linear = true;
+                true
+            }
+            "suppressed" => {
+                *output_linear = false;
+                true
+            }
+            _ => false,
+        };
+    }
+    knobs! {
+        f32: ep_strength.default_gain;
+        f32: ep_strength.default_len;
+        f32: ep_strength.nearend_len;
+        bool: ep_strength.echo_can_saturate;
+        bool: ep_strength.bounded_erl;
+        bool: ep_strength.erle_onset_compensation_in_dominant_nearend;
+        bool: ep_strength.use_conservative_tail_frequency_response;
+        f32: erle.min;
+        f32: erle.max_l;
+        f32: erle.max_h;
+        bool: erle.onset_detection;
+        bool: filter.conservative_initial_phase;
+        usize: filter.refined.length_blocks;
+        f32: filter.refined.leakage_converged;
+        f32: filter.refined.leakage_diverged;
+        f32: filter.refined.error_floor;
+        f32: filter.refined.error_ceil;
+        usize: filter.coarse.length_blocks;
+        f32: filter.coarse.rate;
+        usize: filter.refined_initial.length_blocks;
+        usize: filter.coarse_initial.length_blocks;
+        f32: filter.initial_state_seconds;
+        usize: erle.num_sections;
+        usize: delay.delay_headroom_samples;
+        usize: delay.default_delay;
+        usize: delay.num_filters;
+        usize: delay.hysteresis_limit_blocks;
+        usize: delay.fixed_capture_delay_samples;
