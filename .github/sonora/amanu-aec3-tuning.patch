+/// Amanu: parses a `path=value;...` tuning. `Err(index)` is the 1-based index
+/// of the first entry that is not understood.
+fn parse_aec3_tuning(
+    tuning: *const c_char,
+) -> Result<(sonora::config::EchoCanceller3Config, bool), i32> {
+    let mut cfg = sonora::config::EchoCanceller3Config::default();
+    let mut output_linear = false;
+    if tuning.is_null() {
+        return Ok((cfg, output_linear));
+    }
+    // Safety: the caller passes a NUL-terminated string.
+    let text = unsafe { std::ffi::CStr::from_ptr(tuning) };
+    let Ok(text) = text.to_str() else {
+        return Err(1);
+    };
+    let entries = text.split(';').map(str::trim).filter(|e| !e.is_empty());
+    for (index, entry) in entries.enumerate() {
+        let position = i32::try_from(index + 1).unwrap_or(i32::MAX);
+        let Some((key, value)) = entry.split_once('=') else {
+            return Err(position);
+        };
+        if !apply_aec3_entry(&mut cfg, &mut output_linear, key.trim(), value.trim()) {
+            return Err(position);
+        }
+    }
+    Ok((cfg, output_linear))
+}
+
+/// Amanu: like [`wap_create_with_config()`], but starts from the default AEC3
+/// configuration changed by `tuning`, a NUL-terminated list of `path=value`
+/// entries separated by `;` (paths as in `EchoCanceller3Config`, for example
+/// `suppressor.dominant_nearend_detection.enr_threshold=1.0`). The entry
+/// `output=linear` hands out the linear filter's output instead of the
+/// suppressed one. NULL or empty tuning gives the default AEC3 configuration.
+///
+/// Returns `NULL` if an entry is not understood (see
+/// [`wap_check_aec3_tuning()`]) or on internal error.
+///
+/// # Safety
+///
+/// `tuning` must be NULL or point to a NUL-terminated string.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn wap_create_with_aec3_tuning(
+    config: WapConfig,
+    tuning: *const c_char,
+) -> *mut WapAudioProcessing {
+    ffi_guard_ptr! {
+        let Ok((aec3, output_linear)) = parse_aec3_tuning(tuning) else {
+            return ptr::null_mut();
+        };
+        let rust_config = config.to_rust();
+        let apm = AudioProcessing::builder()
+            .config(rust_config)
+            .echo_canceller3_config(aec3)
+            .aec3_output_linear(output_linear)
+            .build();
+        let boxed = Box::new(WapAudioProcessing { inner: apm });
+        Box::into_raw(boxed)
+    }
+}
+
+/// Amanu: returns 0 if `tuning` is understood, otherwise the 1-based index of
+/// the first entry that is not, or -1 on internal error.
+///
+/// # Safety
+///
+/// `tuning` must be NULL or point to a NUL-terminated string.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn wap_check_aec3_tuning(tuning: *const c_char) -> i32 {
+    match panic::catch_unwind(AssertUnwindSafe(move || parse_aec3_tuning(tuning))) {
+        Ok(Ok(_)) => 0,
+        Ok(Err(index)) => index,
+        Err(_) => -1,
+    }
+}
