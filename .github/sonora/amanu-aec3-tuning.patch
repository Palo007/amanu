+        bool: delay.detect_pre_echo;
+        f32: filter.refined.noise_gate;
+        f32: filter.coarse.noise_gate;
+        f32: filter.refined_initial.leakage_converged;
+        f32: filter.refined_initial.leakage_diverged;
+        f32: filter.refined_initial.error_floor;
+        f32: filter.refined_initial.error_ceil;
+        f32: filter.coarse_initial.rate;
+        usize: filter.config_change_duration_blocks;
+        i32: filter.coarse_reset_hangover_blocks;
+        bool: filter.enable_coarse_filter_output_usage;
+        bool: filter.high_pass_filter_echo_reference;
+        bool: filter.use_linear_filter;
+        bool: filter.export_linear_aec_output;
+        f32: echo_audibility.audibility_threshold_lf;
+        f32: echo_audibility.audibility_threshold_mf;
+        f32: echo_audibility.audibility_threshold_hf;
