+/// Amanu: AEC3 internals for offline diagnosis.
+#[repr(C)]
+#[derive(Debug, Clone, Copy, Default)]
+pub struct WapAec3Debug {
+    /// Echo path delay changes since creation; each one fully resets the linear filter.
+    pub delay_changes: u64,
+    /// The render buffer delay in 4 ms blocks.
+    pub render_delay_blocks: i32,
+    /// The linear filter's direct-path delay in 4 ms blocks.
+    pub filter_delay_blocks: i32,
+    /// Whether AEC3 trusts its linear filter.
+    pub usable_linear_estimate: bool,
+    /// Whether transparent mode (no suppression) is active.
+    pub transparent_mode: bool,
+    /// AEC3's fullband ERLE estimate in dB.
+    pub erle_db: f32,
+}
+
+/// Amanu: reads AEC3's internal state into `out`. Returns
+/// `WapError::NullPointer` for a null argument and `WapError::BadStreamParameter`
+/// when no echo canceller runs.
+///
+/// # Safety
+///
+/// `apm` must be a valid pointer from a `wap_create*` function and `out`
+/// must point to a writable `WapAec3Debug`.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn wap_aec3_debug(
+    apm: *const WapAudioProcessing,
+    out: *mut WapAec3Debug,
+) -> WapError {
+    ffi_guard! {
+        if apm.is_null() || out.is_null() {
+            return WapError::NullPointer;
+        }
+        let apm = unsafe { &*apm };
+        let Some(state) = apm.inner.amanu_aec3_debug() else {
+            return WapError::BadStreamParameter;
+        };
+        let debug = WapAec3Debug {
+            delay_changes: state.delay_changes,
+            render_delay_blocks: state.render_delay_blocks,
+            filter_delay_blocks: state.filter_delay_blocks,
+            usable_linear_estimate: state.usable_linear_estimate,
+            transparent_mode: state.transparent_mode,
+            erle_db: state.erle_log2 * 3.010_3,
+        };
+        unsafe { ptr::write(out, debug) };
+        WapError::None
+    }
+}
