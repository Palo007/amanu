     // policy, not stream state.
 }
 
+LOCALVQE_API int localvqe_prime_delay_begin(localvqe_ctx_t handle) {
+    if (!handle) return -1;
+    auto* ctx = reinterpret_cast<localvqe_ctx*>(handle);
+    if (!ctx->daf.loaded) return -3;
+    localvqe_reset(handle);
+    ctx->prime_best_shift = 0;
+    ctx->prime_best_conf = 0.0f;
+    return 0;
+}
+
+LOCALVQE_API int localvqe_prime_delay_feed(localvqe_ctx_t handle, const float* mic,
+                                           const float* ref, int n_samples) {
+    if (!handle || !mic || !ref || n_samples < 0) return -1;
+    auto* ctx = reinterpret_cast<localvqe_ctx*>(handle);
+    if (!ctx->daf.loaded) return -3;
+    daf_prime_feed(ctx->daf, mic, ref, n_samples, &ctx->prime_best_shift, &ctx->prime_best_conf);
+    return 0;
+}
+
+LOCALVQE_API int localvqe_prime_delay_end(localvqe_ctx_t handle) {
+    if (!handle) return -1;
+    auto* ctx = reinterpret_cast<localvqe_ctx*>(handle);
+    if (!ctx->daf.loaded) return -3;
+    localvqe_reset(handle);
+    daf_prime_finish(ctx->daf, ctx->prime_best_shift, ctx->prime_best_conf);
+    return ctx->daf.gcc_locked ? ctx->daf.cur_shift : -2;
+}
