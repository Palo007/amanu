diff --git a/ggml/localvqe_api.h b/ggml/localvqe_api.h
index 841f050..ca56b8f 100644
--- a/ggml/localvqe_api.h
+++ b/ggml/localvqe_api.h
@@ -262,6 +262,25 @@ LOCALVQE_API void localvqe_reset(localvqe_ctx_t ctx);
  *
  * Returns 0 on success, negative on error.
  */
+/**
+ * Whole-signal bulk-delay prime for offline callers with long signals.
+ *
+ * The 203K cascade normally estimates the echo delay online (GCC-PHAT) and
+ * freezes it after ~3.5 s; that early guess can lock a wrong delay for the
+ * rest of the stream. For a file, call begin, feed the whole mic/ref signal
+ * in order (each chunk a multiple of 128 samples; a partial tail block is
+ * ignored), then end. end() resets the stream state and freezes the
+ * highest-confidence delay, so process_frame_* then runs aligned from frame 0.
+ *
+ * begin/feed return 0, or -3 when the model has no DAF front-end.
+ * end returns the frozen shift in samples (>= 0), -2 when no estimate was
+ * confident (online acquisition stays on), or -3 as above.
+ */
+LOCALVQE_API int localvqe_prime_delay_begin(localvqe_ctx_t ctx);
+LOCALVQE_API int localvqe_prime_delay_feed(localvqe_ctx_t ctx, const float* mic,
+                                           const float* ref, int n_samples);
+LOCALVQE_API int localvqe_prime_delay_end(localvqe_ctx_t ctx);
+
 LOCALVQE_API int localvqe_set_noise_gate(localvqe_ctx_t ctx,
                                         int enabled,
                                         float threshold_dbfs);
