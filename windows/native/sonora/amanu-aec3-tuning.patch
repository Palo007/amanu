+/// Amanu: applies one `path=value` entry to an AEC3 configuration. Returns
+/// `false` if the path is unknown or the value does not parse. `output=linear`
+/// sets `filter.export_linear_aec_output` and `*output_linear`.
+fn apply_aec3_entry(
+    cfg: &mut sonora::config::EchoCanceller3Config,
+    output_linear: &mut bool,
+    key: &str,
+    value: &str,
+) -> bool {
+    macro_rules! knobs {
+        ($($t:ty : $($f:ident).+ ;)*) => {
+            $(
+                if key == stringify!($($f).+).replace(' ', "") {
+                    return match value.parse::<$t>() {
+                        Ok(v) => { cfg$(.$f)+ = v; true }
+                        Err(_) => false,
+                    };
+                }
+            )*
+        };
+    }
+    if key == "output" {
+        return match value {
+            "linear" => {
+                cfg.filter.export_linear_aec_output = true;
+                *output_linear = true;
+                true
+            }
+            "suppressed" => {
+                *output_linear = false;
+                true
+            }
+            _ => false,
+        };
+    }
+    knobs! {
+        f32: ep_strength.default_gain;
+        f32: ep_strength.default_len;
+        f32: ep_strength.nearend_len;
+        bool: ep_strength.echo_can_saturate;
+        bool: ep_strength.bounded_erl;
+        bool: ep_strength.erle_onset_compensation_in_dominant_nearend;
+        bool: ep_strength.use_conservative_tail_frequency_response;
+        f32: erle.min;
+        f32: erle.max_l;
+        f32: erle.max_h;
+        bool: erle.onset_detection;
+        bool: filter.conservative_initial_phase;
+        usize: filter.refined.length_blocks;
+        f32: filter.refined.leakage_converged;
+        f32: filter.refined.leakage_diverged;
+        f32: filter.refined.error_floor;
+        f32: filter.refined.error_ceil;
+        usize: filter.coarse.length_blocks;
+        f32: filter.coarse.rate;
+        usize: filter.refined_initial.length_blocks;
+        usize: filter.coarse_initial.length_blocks;
+        f32: filter.initial_state_seconds;
+        usize: erle.num_sections;
+        usize: delay.delay_headroom_samples;
+        bool: filter.use_linear_filter;
+        bool: filter.export_linear_aec_output;
+        f32: echo_audibility.audibility_threshold_lf;
+        f32: echo_audibility.audibility_threshold_mf;
+        f32: echo_audibility.audibility_threshold_hf;
+        bool: echo_removal_control.linear_and_stable_echo_path;
+        f32: comfort_noise.noise_floor_dbfs;
+        usize: suppressor.nearend_average_blocks;
+        f32: suppressor.normal_tuning.mask_lf.enr_transparent;
+        f32: suppressor.normal_tuning.mask_lf.enr_suppress;
+        f32: suppressor.normal_tuning.mask_lf.emr_transparent;
+        f32: suppressor.normal_tuning.mask_hf.enr_transparent;
+        f32: suppressor.normal_tuning.mask_hf.enr_suppress;
+        f32: suppressor.normal_tuning.mask_hf.emr_transparent;
+        f32: suppressor.normal_tuning.max_inc_factor;
+        f32: suppressor.normal_tuning.max_dec_factor_lf;
+        f32: suppressor.nearend_tuning.mask_lf.enr_transparent;
+        f32: suppressor.nearend_tuning.mask_lf.enr_suppress;
+        f32: suppressor.nearend_tuning.mask_lf.emr_transparent;
+        f32: suppressor.nearend_tuning.mask_hf.enr_transparent;
+        f32: suppressor.nearend_tuning.mask_hf.enr_suppress;
+        f32: suppressor.nearend_tuning.mask_hf.emr_transparent;
+        f32: suppressor.nearend_tuning.max_inc_factor;
+        f32: suppressor.nearend_tuning.max_dec_factor_lf;
+        f32: suppressor.dominant_nearend_detection.enr_threshold;
+        f32: suppressor.dominant_nearend_detection.enr_exit_threshold;
+        f32: suppressor.dominant_nearend_detection.snr_threshold;
+        i32: suppressor.dominant_nearend_detection.hold_duration;
+        i32: suppressor.dominant_nearend_detection.trigger_threshold;
+        bool: suppressor.dominant_nearend_detection.use_during_initial_phase;
+        bool: suppressor.dominant_nearend_detection.use_unbounded_echo_spectrum;
+        bool: suppressor.use_subband_nearend_detection;
+        usize: suppressor.subband_nearend_detection.nearend_average_blocks;
+        f32: suppressor.subband_nearend_detection.nearend_threshold;
+        f32: suppressor.subband_nearend_detection.snr_threshold;
+        f32: suppressor.high_bands_suppression.enr_threshold;
+        f32: suppressor.high_bands_suppression.max_gain_during_echo;
+        f32: suppressor.floor_first_increase;
+        bool: suppressor.conservative_hf_suppression;
+    }
+    false
+}
+
+/// Amanu: parses a `path=value;...` tuning. `Err(index)` is the 1-based index
+/// of the first entry that is not understood.
+fn parse_aec3_tuning(
+    tuning: *const c_char,
+) -> Result<(sonora::config::EchoCanceller3Config, bool), i32> {
+    let mut cfg = sonora::config::EchoCanceller3Config::default();
+    let mut output_linear = false;
+    if tuning.is_null() {
+        return Ok((cfg, output_linear));
+    }
+    // Safety: the caller passes a NUL-terminated string.
+    let text = unsafe { std::ffi::CStr::from_ptr(tuning) };
+    let Ok(text) = text.to_str() else {
+        return Err(1);
+    };
+    let entries = text.split(';').map(str::trim).filter(|e| !e.is_empty());
+    for (index, entry) in entries.enumerate() {
+        let position = i32::try_from(index + 1).unwrap_or(i32::MAX);
+        let Some((key, value)) = entry.split_once('=') else {
+            return Err(position);
+        };
+        if !apply_aec3_entry(&mut cfg, &mut output_linear, key.trim(), value.trim()) {
+            return Err(position);
+        }
+    }
+    Ok((cfg, output_linear))
+}
