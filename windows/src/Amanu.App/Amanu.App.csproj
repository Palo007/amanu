<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWindowsForms>true</UseWindowsForms>
    <StartupObject>Amanu.App.App</StartupObject>
    <AssemblyName>Amanu</AssemblyName>
    <RootNamespace>Amanu.App</RootNamespace>
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../../../VERSION').Trim())</Version>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Amanu.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
    <Resource Include="Assets\Amanu.ico" />
    <Content Include="../../Licenses/Markdig.txt" Link="Licenses/Markdig.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Offline echo cancellation: LocalVQE, CPU-only, loaded by full path from echo-runtime\ (see native/localvqe/README.md). -->
    <Content Include="../../native/localvqe/liblocalvqe.dll" Link="echo-runtime/liblocalvqe.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../native/localvqe/localvqe-v1.4-aec-200K-f32.gguf" Link="echo-runtime/localvqe-v1.4-aec-200K-f32.gguf" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../native/localvqe/localvqe-v1.4-aec-2.7K-f32.gguf" Link="echo-runtime/localvqe-v1.4-aec-2.7K-f32.gguf" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../Licenses/LocalVQE.txt" Link="Licenses/LocalVQE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../Licenses/ggml.txt" Link="Licenses/ggml.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- WinForms is here for the tray icon alone; its names must not shadow WPF's. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Amanu.Core/Amanu.Core.csproj" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="NAudio" />
    <PackageReference Include="org.k2fsa.sherpa.onnx" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.win-x64" />
    <PackageReference Include="Velopack" />
  </ItemGroup>
</Project>
